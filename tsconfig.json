{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@hannasage/armature": ["./src/index.ts"],
      "@hannasage/armature/dom": ["./src/dom/index.ts"],
      "@hannasage/armature/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"]
}
