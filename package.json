{
  "name": "@hannasage/armature",
  "version": "1.0.0-beta.0",
  "description": "A physics motion engine for the web. One engine, many flavors.",
  "license": "MIT",
  "author": "Hanna Sage",
  "keywords": [
    "animation",
    "motion",
    "spring",
    "physics",
    "liquid-glass",
    "react",
    "esm",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame": {
      "types": "./dist/frame/index.d.ts",
      "import": "./dist/frame/index.js"
    },
    "./values": {
      "types": "./dist/values/index.d.ts",
      "import": "./dist/values/index.js"
    },
    "./curves": {
      "types": "./dist/curves/index.d.ts",
      "import": "./dist/curves/index.js"
    },
    "./linear": {
      "types": "./dist/linear/index.d.ts",
      "import": "./dist/linear/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./glass": {
      "types": "./dist/glass/index.d.ts",
      "import": "./dist/glass/index.js"
    },
    "./glass/react": {
      "types": "./dist/glass/react/index.d.ts",
      "import": "./dist/glass/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs && node scripts/check-exports.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "release": "node scripts/release.mjs",
    "gates": "node tools/gates.mjs",
    "pr-open": "node tools/pr-open.mjs",
    "tree-clean": "node tools/tree-clean.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:pack",
    "check:readme": "node scripts/check-readme.mjs",
    "size": "node scripts/size.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
